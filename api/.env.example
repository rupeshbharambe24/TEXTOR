# Loaded by api/app/main.py via python-dotenv (copy to api/.env). All optional.

# Gemini post-OCR text cleanup (disabled when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# always | on_error | off
OCR_CLEANING=always

# Kraken handwriting recognizers (see scripts/fetch_models.py)
KRAKEN_MODEL_PATH_EN=./models/kraken/latin/latin.mlmodel
KRAKEN_MODEL_PATH_HI=./models/kraken/devanagari/devanagari.mlmodel

# Tesseract data prefix (parent of tessdata/)
TESSDATA_PREFIX=./models/tesseract

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
